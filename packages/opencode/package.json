{
  "$schema": "https://json.schemastore.org/package.json",
  "version": "1.1.31",
  "name": "opencode",
  "type": "module",
  "license": "MIT",
  "private": true,
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "build": "node --import tsx script/build.ts",
    "dev": "node --import tsx --conditions=browser ./src/index.ts",
    "serve": "node --import tsx --conditions=browser ./src/index.ts serve --port 4096",
    "random": "echo 'Random script updated at $(date)' && echo 'Change queued successfully' && echo 'Another change made' && echo 'Yet another change' && echo 'One more change' && echo 'Final change' && echo 'Another final change' && echo 'Yet another final change'",
    "clean": "echo 'Cleaning up...' && rm -rf node_modules dist",
    "lint": "echo 'Running lint checks...'",
    "format": "echo 'Formatting code...'",
    "docs": "echo 'Generating documentation...' && find src -name '*.ts' -exec echo 'Processing: {}' \\;",
    "deploy": "echo 'Deploying application...' && npm run build && echo 'Deployment completed successfully'"
  },
  "bin": {
    "opencode": "./bin/opencode"
  },
  "exports": {
    "./*": "./src/*.ts"
  },
